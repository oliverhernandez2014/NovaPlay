<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="widsvavas
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            user-select: none;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Contenedor del Juego (Proporción clásica de pantalla) */
        .game-container {
            width: 800px;
            height: 400px;
            background: linear-gradient(to bottom, #1a0033 0%, #001133 100%);
            position: relative;
            overflow: hidden;
            border: 4px solid #00ffff;
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.3);
        }

        /* Líneas de fondo estilo rejilla retro de Geometry Dash */
        .bg-grid {
            position: absolute;
            width: 200%;
            height: 100%;
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
            background-size: 40px 40px;
            animation: moveGrid 3s linear infinite;
        }

        @keyframes moveGrid {
            0% { transform: translateX(0); }
            100% { transform: translateX(-40px); }
        }

        /* El Suelo Línea de Impacto */
        .floor {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 80px;
            background: #002244;
            border-top: 3px solid #00ffaa;
            box-shadow: 0 -5px 15px rgba(0, 255, 170, 0.4);
            z-index: 10;
        }

        /* El Cubo (Jugador) */
        .cube {
            width: 40px;
            height: 40px;
            background: #00ff00;
            border: 3px solid #ffffff;
            box-shadow: 0 0 15px #00ff00;
            position: absolute;
            left: 100px;
            bottom: 80px; /* Justo sobre el suelo */
            z-index: 5;
            border-radius: 4px;
            transform-origin: center bottom;
        }

        /* Ojos decorativos del cubo para darle personalidad */
        .cube::before, .cube::after {
            content: '';
            position: absolute;
            top: 10px;
            width: 8px;
            height: 8px;
            background: black;
            border-radius: 2px;
        }
        .cube::before { left: 8px; }
        .cube::after { right: 8px; }

        /* Animación de rotación al saltar */
        .cube.jumping {
            animation: jumpRotate 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes jumpRotate {
            0% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-100px) rotate(45deg); }
            100% { transform: translateY(0) rotate(90deg); }
        }

        /* Obstáculo: Espina (Triángulo) */
        .obstacle {
            position: absolute;
            bottom: 80px;
            width: 0;
            height: 0;
            border-left: 20px solid transparent;
            border-right: 20px solid transparent;
            border-bottom: 40px solid #ff0055;
            filter: drop-shadow(0 0 8px #ff0055);
            z-index: 4;
        }

        /* Panel de Interfaces */
        .hud {
            position: absolute;
            top: 20px;
            width: 100%;
            display: flex;
            justify-content: space-between;
            padding: 0 30px;
            color: white;
            font-size: 18px;
            font-weight: bold;
            text-shadow: 2px 2px 4px #000;
            z-index: 20;
        }

        .percentage {
            font-size: 24px;
            color: #ffff00;
        }

        /* Pantalla de Crash / Intento fallido */
        .flash-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 0, 85, 0.3);
            display: none;
            z-index: 30;
            pointer-events: none;
        }

        /* Instrucciones al inicio */
        .instruction {
            position: absolute;
            width: 100%;
            text-align: center;
            bottom: 120px;
            color: rgba(255, 255, 255, 0.6);
            font-size: 14px;
            letter-spacing: 1px;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.4; }
            50% { opacity: 1; }
        }
    </style>
</head>
<body onclick="jump()">

    <div class="game-container">
        <div class="bg-grid"></div>
        
        <div class="hud">
            <div id="attempt-counter">INTENTO 1</div>
            <div id="percent-display" class="percentage">0%</div>
        </div>

        <div class="instruction" id="ins-text">PRESIONA ESPACIO O HAZ CLIC PARA SALTAR</div>

        <div class="cube" id="player"></div>
        <div id="obstacles-container"></div>
        <div class="floor"></div>

        <div class="flash-screen" id="flash"></div>
    </div>

    <script>
        const player = document.getElementById('player');
        const container = document.getElementById('obstacles-container');
        const percentDisplay = document.getElementById('percent-display');
        const attemptCounter = document.getElementById('attempt-counter');
        const flash = document.getElementById('flash');
        const insText = document.getElementById('ins-text');

        let isJumping = false;
        let score = 0;
        let attempts = 1;
        let gameSpeed = 5;
        let obstacleTimer = 0;
        let gameActive = true;
        let obstacleList = [];

        // --- LÓGICA DE SALTO ---
        function jump() {
            if (!gameActive || isJumping) return;
            
            isJumping = true;
            player.classList.add('jumping');
            insText.style.display = 'none';

            // El salto dura 500ms (ajustado con la animación CSS)
            setTimeout(() => {
                player.classList.remove('jumping');
                isJumping = false;
            }, 500);
        }

        // Detectar Tecla Espacio o Flecha Arriba
        window.addEventListener('keydown', (e) => {
            if (e.key === ' ' || e.key === 'ArrowUp') {
                jump();
            }
        });

        // --- GENERADOR DE OBSTÁCULOS (ESPINAS) ---
        function spawnObstacle() {
            if (!gameActive) return;

            const obstacle = document.createElement('div');
            obstacle.classList.add('obstacle');
            obstacle.style.left = '800px'; // Empieza al borde derecho del contenedor
            container.appendChild(obstacle);
            obstacleList.push(obstacle);
        }

        // --- BUCLE PRINCIPAL DEL JUEGO ---
        function updateGame() {
            if (!gameActive) {
                requestAnimationFrame(updateGame);
                return;
            }

            // 1. Progresión del porcentaje e incremento de velocidad progresivo
            score += 0.1;
            if (score > 100) score = 0; // Reinicia el nivel al llegar a 100%
            percentDisplay.textContent = `${Math.floor(score)}%`;
            gameSpeed = 5 + (score * 0.05); // Se vuelve más rápido con el tiempo

            // 2. Controlar la aparición aleatoria/rítmica de espinas
            obstacleTimer++;
            if (obstacleTimer > Math.random() * (120 - 70) + 70) { 
                spawnObstacle();
                obstacleTimer = 0;
            }

            // 3. Mover obstáculos y detectar colisiones
            for (let i = obstacleList.length - 1; i >= 0; i--) {
                const obs = obstacleList[i];
                let currentLeft = parseFloat(obs.style.left);
                currentLeft -= gameSpeed;
                obs.style.left = `${currentLeft}px`;

                // Eliminar obstáculos que ya salieron de la pantalla por la izquierda
                if (currentLeft < -40) {
                    obs.remove();
                    obstacleList.splice(i, 1);
                    continue;
                }

                // --- DETECCIÓN DE COLISIÓN (HITBOX) ---
                // Parámetros fijos basados en el diseño CSS
                const playerX = 100; // Left fijo del jugador
                const playerWidth = 40;
                const playerHeight = 40;
                
                // Calcular altura del jugador dinámicamente si está saltando
                let playerBottom = 0;
                if (isJumping) {
                    // Simulación matemática de arco del salto para sincronizar con la hitbox de la animación
                    const jumpProgress = (Date.now() % 500) / 500; 
                    // Aproximación de la curva del salto
                    playerBottom = Math.sin(Math.PI * (player.style.animationPlayState === 'paused' ? 0 : 1)) * 100; 
                }
                
                // Hitbox real usandogetBoundingClientRect para precisión absoluta
                const playerRect = player.getBoundingClientRect();
                const obsRect = obs.getBoundingClientRect();

                if (
                    playerRect.right > obsRect.left + 8 && 
                    playerRect.left < obsRect.right - 8 && 
                    playerRect.bottom > obsRect.top + 5
                ) {
                    gameOver();
                }
            }

            requestAnimationFrame(updateGame);
        }

        // --- FUNCIÓN DE GAME OVER (CRASH) ---
        function gameOver() {
            gameActive = false;
            flash.style.display = 'block'; // Destello de pantalla roja
            player.style.background = '#ff0055'; // El cubo cambia de color al romperse
            player.style.boxShadow = '0 0 25px #ff0055';

            setTimeout(() => {
                // Reiniciar mapa e interfaz
                flash.style.display = 'none';
                container.innerHTML = '';
                obstacleList = [];
                score = 0;
                attempts++;
                attemptCounter.textContent = `INTENTO ${attempts}`;
                
                // Restaurar cubo
                player.style.background = '#00ff00';
                player.style.boxShadow = '0 0 15px #00ff00';
                player.classList.remove('jumping');
                isJumping = false;
                
                gameActive = true;
            }, 600); // Pequeña pausa dramática antes de reaparecer
        }

        // Iniciar bucle principal
        updateGame();
    </script>
</body>
</html>
